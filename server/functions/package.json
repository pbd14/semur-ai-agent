{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "serve:demo": "npm run build && firebase emulators:start --only auth,firestore,functions",
    "shell": "npm run build && firebase functions:shell",
    "test": "npm run build && node --test lib/modules/agents/email_assistant/executive_orchestrator.test.js lib/modules/agents/email_assistant/demo/demo_orchestrator.test.js",
    "seed:demo": "npm run build && node scripts/seed-demo.cjs",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@genkit-ai/compat-oai": "^1.19.3",
    "@genkit-ai/google-genai": "^1.19.3",
    "@genkit-ai/googleai": "^1.19.2",
    "@genkit-ai/mcp": "^1.19.2",
    "@modelcontextprotocol/sdk": "^1.18.0",
    "@nangohq/node": "^0.67.7",
    "axios": "^1.12.1",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.0.1",
    "genkit": "^1.19.2",
    "html-to-text": "^9.0.5",
    "nanoid": "^5.1.5",
    "telegraf": "^4.16.3",
    "ts-proto": "^2.7.7"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.32.0",
    "@types/handlebars": "^4.1.0",
    "@types/html-to-text": "^9.0.4",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "eslint": "^9.32.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.1.0",
    "typescript": "^5.7.3"
  },
  "private": true
