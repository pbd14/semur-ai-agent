{
  "compilerOptions": {
    "module": "CommonJS",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2017",
    // Needed because of issues with handlebars package related to genkit and dotprompt
    "skipLibCheck": true,
  },
  "compileOnSave": true,
  "include": [
    "src",
    "src/modules",
    "src/accessors",
    "src/helpers",
    "types"
  ]
}
